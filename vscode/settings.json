{
  "editor.fontSize": 13,
  "editor.formatOnSave": true,
  "editor.tabSize": 2,
  "editor.rulers": [100],
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "terminal.integrated.fontSize": 13,
  "git.autofetch": true,
  "workbench.iconTheme": "material-icon-theme",
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "claudeCode.preferredLocation": "panel",
  "editor.fontFamily": "'IBM Plex Mono', Menlo, monospace",
  "editor.fontWeight": "400",
  "terminal.integrated.fontFamily": "'IBM Plex Mono'",
  "workbench.colorCustomizations": {
    "editor.background": "#1d1d16",
    "editor.foreground": "#fbfbf9",
    "editorGutter.background": "#1d1d16",
    "breadcrumb.background": "#1d1d16",
    "editorGroupHeader.tabsBackground": "#1d1d16",
    "tab.activeBackground": "#1d1d16",
    "tab.inactiveBackground": "#1d1d16",
    "editor.stickyScrollBackground": "#1d1d16",
    "sideBar.background": "#0c0c09",
    "sideBar.foreground": "#fbfbf9",
    "activityBar.background": "#0c0c09",
    "panel.background": "#1d1d16",
    "statusBar.background": "#0c0c09",
    "focusBorder": "#ffffff1a",
    "descriptionForeground": "#abab9c",
    "terminal.background": "#1d1d16",
    "terminal.foreground": "#fbfbf9",
    "terminal.ansiGreen": "#00d294",
    "terminal.ansiYellow": "#ffd236",
    "terminal.ansiRed": "#ff2357",
    "terminal.ansiBlue": "#38bdf8",
    "terminal.ansiMagenta": "#c4b4ff"
  },
}
